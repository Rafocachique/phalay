generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model SystemSettings {
  id               String   @id @default(uuid()) @db.Uuid
  storeName        String   @default("Mi Tienda") @map("store_name")
  logoUrl          String?  @map("logo_url")
  bannerUrl        String?  @map("banner_url")
  contactEmail     String?  @map("contact_email")
  contactPhone     String?  @map("contact_phone")
  socialLinks      Json     @default("{}") @map("social_links")
  updatedAt        DateTime @updatedAt @map("updated_at")
  storeDescription String?  @map("store_description")

  // Métodos de pago habilitados en el checkout. La transferencia manual viene
  // desactivada por defecto: sólo se muestra si el admin la activa (p. ej.
  // cuando Culqi no está disponible).
  paymentCardEnabled   Boolean @default(true) @map("payment_card_enabled")
  paymentYapeEnabled   Boolean @default(true) @map("payment_yape_enabled")
  paymentManualEnabled Boolean @default(false) @map("payment_manual_enabled")
  /// Sólo para referencia interna del administrador: NUNCA se expone en la
  /// tienda. Publicar el número invita a que terceros lo usen para estafar
  /// haciéndose pasar por la marca; la clienta paga escaneando el QR.
  yapeNumber           String? @map("yape_number")
  yapeQrUrl            String? @map("yape_qr_url")
  /// Número al que la clienta envía su captura de pago (botón de WhatsApp).
  whatsappNumber       String? @map("whatsapp_number")
  manualPaymentInfo    String? @map("manual_payment_info")

  @@map("system_settings")
}

model Faq {
  id        String   @id @default(uuid()) @db.Uuid
  question  String
  answer    String
  position  Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("faqs")
}

model User {
  id             String            @id @default(uuid()) @db.Uuid
  email          String            @unique
  firstName      String            @map("first_name")
  lastName       String            @map("last_name")
  phone          String?
  avatarUrl      String?           @map("avatar_url")
  dni            String?           @db.VarChar(8)
  role           UserRole          @default(CUSTOMER)
  status         EntityStatus      @default(ACTIVE)
  emailVerified  Boolean           @default(false) @map("email_verified")
  phoneVerified  Boolean           @default(false) @map("phone_verified")
  verificationCode          String?   @map("verification_code")
  verificationCodeExpiresAt DateTime? @map("verification_code_expires_at")
  verificationAttempts      Int       @default(0) @map("verification_attempts")
  locale         String            @default("es")
  lastLoginAt    DateTime?         @map("last_login_at")
  loginCount     Int               @default(0) @map("login_count")
  supabaseAuthId String            @unique @map("supabase_auth_id") @db.Uuid
  metadata       Json?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")
  createdBy      String?           @map("created_by") @db.Uuid
  updatedBy      String?           @map("updated_by") @db.Uuid
  auditLogs      AuditLog[]        @relation("AuditUser")
  notifications  Notification[]
  orders         Order[]
  payments       Payment[]
  reviews        Review[]
  addresses      ShippingAddress[]
  sessions       UserSession[]
  yapePayments   YapePayment[]     @relation("YapeCustomer")
  missingRequests MissingDestinationRequest[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([supabaseAuthId])
  @@map("users")
}

model UserSession {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  userAgent    String?  @map("user_agent")
  ip           String?
  platform     String?
  fingerprint  String?
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model ShippingAddress {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  label      String
  firstName  String    @map("first_name")
  lastName   String    @map("last_name")
  phone      String
  street     String
  apartment  String?
  city       String
  state      String
  postalCode String    @map("postal_code")
  country    String    @default("PE")
  lat        Float?
  lng        Float?
  isDefault  Boolean   @default(false) @map("is_default")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  orders     Order[]
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("shipping_addresses")
}

model ProductCategory {
  id          String            @id @default(uuid()) @db.Uuid
  parentId    String?           @map("parent_id") @db.Uuid
  name        String
  slug        String            @unique
  description String?
  imageUrl    String?           @map("image_url")
  position    Int               @default(0)
  isActive    Boolean           @default(true) @map("is_active")
  isGlobal    Boolean           @default(false) @map("is_global")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")
  parent      ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    ProductCategory[] @relation("CategoryTree")
  products    Product[]

  @@index([parentId])
  @@map("product_categories")
}

model Collection {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  position    Int       @default(0)
  products    Product[] @relation("ProductCollections")

  @@map("collections")
}

model Product {
  id               String           @id @default(uuid()) @db.Uuid
  categoryId       String           @map("category_id") @db.Uuid
  name             String
  slug             String           @unique
  description      String
  shortDescription String?          @map("short_description")
  sku              String           @unique
  status           ProductStatus    @default(DRAFT)
  price            Decimal          @db.Decimal(12, 2)
  compareAtPrice   Decimal?         @map("compare_at_price") @db.Decimal(12, 2)
  costPrice        Decimal?         @map("cost_price") @db.Decimal(12, 2)
  currency         String           @default("PEN")
  tags             String[]         @default([])
  weight           Float?
  dimensions       Json?
  seoTitle         String?          @map("seo_title")
  seoDescription   String?          @map("seo_description")
  featured         Boolean          @default(false)
  rating           Float            @default(0)
  reviewCount      Int              @default(0) @map("review_count")
  totalSold        Int              @default(0) @map("total_sold")
  viewCount        Int              @default(0) @map("view_count")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")
  createdBy        String?          @map("created_by") @db.Uuid
  updatedBy        String?          @map("updated_by") @db.Uuid
  position         Int              @default(0)
  orderItems       OrderItem[]
  images           ProductImage[]
  variants         ProductVariant[]
  category         ProductCategory  @relation(fields: [categoryId], references: [id])
  reviews          Review[]
  collections      Collection[]     @relation("ProductCollections")

  @@index([categoryId])
  @@index([status])
  @@index([price])
  @@index([featured])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String
  altText   String?  @map("alt_text")
  position  Int      @default(0)
  isMain    Boolean  @default(false) @map("is_main")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id                String      @id @default(uuid()) @db.Uuid
  productId         String      @map("product_id") @db.Uuid
  name              String
  sku               String
  price             Decimal     @db.Decimal(12, 2)
  compareAtPrice    Decimal?    @map("compare_at_price") @db.Decimal(12, 2)
  stock             Int         @default(0)
  reservedStock     Int         @default(0) @map("reserved_stock")
  lowStockThreshold Int         @default(5) @map("low_stock_threshold")
  size              String?
  color             String?
  colorHex          String?     @map("color_hex")
  imageUrl          String?     @map("image_url")
  isActive          Boolean     @default(true) @map("is_active")
  position          Int         @default(0)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  orderItems        OrderItem[]
  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([sku, productId])
  @@index([productId])
  @@index([stock])
  @@map("product_variants")
}

model Order {
  id                 String          @id @default(uuid()) @db.Uuid
  orderNumber        String          @unique @map("order_number")
  customerId         String          @map("customer_id") @db.Uuid
  addressId          String          @map("address_id") @db.Uuid
  status             OrderStatus     @default(PENDING)
  paymentMethod      String          @map("payment_method")
  paymentStatus      PaymentStatus   @default(PENDING)
  subtotal           Decimal         @db.Decimal(12, 2)
  shippingCost       Decimal         @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  shippingType       String?         @map("shipping_type")
  shippingDestinationId String?      @map("shipping_destination_id") @db.Uuid
  customShippingText String?         @map("custom_shipping_text")
  isShippingPaid     Boolean         @default(false) @map("is_shipping_paid")
  tax                Decimal         @default(0) @db.Decimal(12, 2)
  discount           Decimal         @default(0) @db.Decimal(12, 2)
  total              Decimal         @db.Decimal(12, 2)
  currency           String          @default("PEN")
  notes              String?
  trackingNumber     String?         @map("tracking_number")
  trackingUrl        String?         @map("tracking_url")
  estimatedDelivery  DateTime?       @map("estimated_delivery")
  deliveredAt        DateTime?       @map("delivered_at")
  cancelledAt        DateTime?       @map("cancelled_at")
  cancellationReason String?         @map("cancellation_reason")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  deletedAt          DateTime?       @map("deleted_at")
  items              OrderItem[]
  timeline           OrderTimeline[]
  address            ShippingAddress @relation(fields: [addressId], references: [id])
  customer           User            @relation(fields: [customerId], references: [id])
  payments           Payment[]
  yapePayments       YapePayment[]
  destination        ShippingDestination? @relation(fields: [shippingDestinationId], references: [id])
  missingRequests    MissingDestinationRequest[]

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String          @id @default(uuid()) @db.Uuid
  orderId     String          @map("order_id") @db.Uuid
  productId   String          @map("product_id") @db.Uuid
  variantId   String?         @map("variant_id") @db.Uuid
  productName String          @map("product_name")
  variantName String?         @map("variant_name")
  sku         String
  imageUrl    String?         @map("image_url")
  quantity    Int
  unitPrice   Decimal         @map("unit_price") @db.Decimal(12, 2)
  totalPrice  Decimal         @map("total_price") @db.Decimal(12, 2)
  size        String?
  color       String?
  createdAt   DateTime        @default(now()) @map("created_at")
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model OrderTimeline {
  id          String      @id @default(uuid()) @db.Uuid
  orderId     String      @map("order_id") @db.Uuid
  status      OrderStatus
  description String
  createdAt   DateTime    @default(now()) @map("created_at")
  createdBy   String?     @map("created_by") @db.Uuid
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_timeline")
}

model Payment {
  id                   String                   @id @default(uuid()) @db.Uuid
  orderId              String                   @map("order_id") @db.Uuid
  customerId           String                   @map("customer_id") @db.Uuid
  method               String
  gateway              String?
  status               PaymentTransactionStatus @default(INITIATED)
  amount               Decimal                  @db.Decimal(12, 2)
  currency             String                   @default("PEN")
  gatewayTransactionId String?                  @map("gateway_transaction_id")
  gatewayResponse      Json?                    @map("gateway_response")
  metadata             Json?
  paidAt               DateTime?                @map("paid_at")
  refundedAt           DateTime?                @map("refunded_at")
  failureReason        String?                  @map("failure_reason")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  customer             User                     @relation(fields: [customerId], references: [id])
  order                Order                    @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model YapePayment {
  id              String            @id @default(uuid()) @db.Uuid
  orderId         String            @map("order_id") @db.Uuid
  customerId      String            @map("customer_id") @db.Uuid
  qrCodeUrl       String            @map("qr_code_url")
  approvalCode    String?           @map("approval_code")
  receiptUrl      String?           @map("receipt_url")
  status          YapePaymentStatus @default(PENDING_UPLOAD)
  amount          Decimal           @db.Decimal(12, 2)
  verifiedAt      DateTime?         @map("verified_at")
  verifiedBy      String?           @map("verified_by") @db.Uuid
  rejectionReason String?           @map("rejection_reason")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  customer        User              @relation("YapeCustomer", fields: [customerId], references: [id])
  order           Order             @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@map("yape_payments")
}

model Review {
  id        String    @id @default(uuid()) @db.Uuid
  productId String    @map("product_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  rating    Int
  title     String?
  comment   String?
  images    String[]  @default([])
  verified  Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  product   Product   @relation(fields: [productId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([productId, userId])
  @@index([productId])
  @@index([rating])
  @@map("reviews")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  title     String
  message   String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  oldValues Json?    @map("old_values")
  newValues Json?    @map("new_values")
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation("AuditUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentTransactionStatus {
  INITIATED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum YapePaymentStatus {
  PENDING_UPLOAD
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  EXPIRED
}

/// Catálogo de transportistas (Shalom, Olva, etc.). Existe para que los
/// destinos referencien una agencia estandarizada en vez de texto libre,
/// que producía datos sucios ("shalon", "SHALOM", "shalom courier").
model ShippingAgency {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  trackingUrl  String?  @map("tracking_url")
  contactPhone String?  @map("contact_phone")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  destinations ShippingDestination[]

  @@map("shipping_agencies")
}

model ShippingDestination {
  id            String   @id @default(uuid()) @db.Uuid
  type          String   // "LIMA" or "PROVINCIA"
  department    String?
  province      String?
  district      String?
  agencyId      String?  @map("agency_id") @db.Uuid
  agencyName    String?  @map("agency_name")
  agencyAddress String?  @map("agency_address")
  price         Decimal  @db.Decimal(12, 2)
  estimatedDays String?  @map("estimated_days")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  agency        ShippingAgency? @relation(fields: [agencyId], references: [id])
  orders        Order[]

  @@index([agencyId])
  @@map("shipping_destinations")
}

model MissingDestinationRequest {
  id             String   @id @default(uuid()) @db.Uuid
  requestedName  String   @map("requested_name")
  type           String   // "LIMA" or "PROVINCIA"
  status         String   @default("PENDING") // PENDING, RESOLVED
  orderId        String?  @map("order_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  
  order          Order?   @relation(fields: [orderId], references: [id])
  customer       User     @relation(fields: [customerId], references: [id])

  @@index([status])
  @@map("missing_destination_requests")
}
