# Copia este archivo a .env y completa los valores reales.
# .env está en .gitignore — nunca commitees secretos reales.

NODE_ENV=development
API_PORT=4000

# URLs públicas de las apps
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_SELLER_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Base de datos (Supabase/Postgres)
DATABASE_URL=
DIRECT_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth — genera un secreto real de al menos 64 caracteres, nunca uses el placeholder
JWT_SECRET=

# Redis (opcional, no usado activamente todavía)
REDIS_URL=

# Culqi (pagos)
CULQI_SECRET_KEY=
# Secreto compartido para validar el webhook de Culqi (?secret=... en la URL registrada en Culqi)
CULQI_WEBHOOK_SECRET=

# CORS — lista de orígenes permitidos separados por coma, sólo se usa cuando NODE_ENV=production
CORS_ALLOWED_ORIGINS=https://tu-dominio.com,https://admin.tu-dominio.com

# Administrador semilla — si se omiten, no se crea ningún admin automáticamente al arrancar
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Resend (correos transaccionales) — https://resend.com/api-keys
RESEND_API_KEY=
# Remitente: debe ser un dominio verificado en Resend, o onboarding@resend.dev en desarrollo
RESEND_FROM_EMAIL=
