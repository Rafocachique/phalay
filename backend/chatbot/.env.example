# Servicio privado. No usar NEXT_PUBLIC_ para ninguno de estos secretos.
CHATBOT_API_KEY=replace-with-a-random-secret-at-least-32-characters
CHATBOT_KNOWLEDGE_SOURCE=json
# Ruta relativa a backend/chatbot. Por defecto no contiene políticas inventadas.
CHATBOT_KNOWLEDGE_FILE=knowledge/base.json
# Para usar Supabase: source=supabase y aplicar migrations/001_knowledge.sql
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace
CHATBOT_STORE_ID=your-store-id
